# Supabase > Connect > Session pooler (porta 5432).
# Nunca exponha esta URL no JavaScript ou envie a senha ao GitHub.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_MIN=1
DB_POOL_MAX=5
SECRET_KEY=troque-por-uma-chave-segura-com-32-caracteres
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_TIMEZONE=America/Sao_Paulo
RUN_DB_MIGRATIONS=true
ENABLE_BACKGROUND_WORKER=true

# Imagens persistentes em produção. Nunca exponha SERVICE_ROLE no navegador.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cortaflow-images
# WhatsApp Business Cloud API oficial da Meta.
WHATSAPP_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=confirmacao_agendamento

# Confirmação de agendamento por e-mail (Resend)
RESEND_API_KEY=
# Em produção, use um remetente do domínio verificado no Resend.
EMAIL_FROM=CortaFlow <nao-responda@cortaflow.com.br>
# Endereço público usado nos links de confirmação de conta.
PUBLIC_BASE_URL=https://cortaflow.com.br

# Login com Google (OAuth 2.0 / OpenID Connect).
# No Google Cloud, cadastre exatamente o redirect abaixo em "URIs de redirecionamento autorizados".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cortaflow.com.br/api/auth/google/callback
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Protege o endpoint que processa retentativas em ambiente serverless.
CRON_SECRET=

# Stripe Billing. Os valores dos três planos são definidos no backend.
STRIPE_SECRET_KEY=sk_test_
# Stripe > Developers > Webhooks > endpoint /api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_ESSENCIAL=price_
STRIPE_PRICE_PROFISSIONAL=price_
STRIPE_PRICE_PREMIUM=price_

# Sessões do painel. Produção deve usar uma SECRET_KEY aleatória com 32+ bytes.
ACCESS_TOKEN_TTL_MINUTES=480
JWT_ISSUER=cortaflow
JWT_AUDIENCE=cortaflow-web

# Web Push para notificações do PWA. Gere um par VAPID uma única vez e
# mantenha a chave privada somente no servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=contato@cortaflow.com.br
